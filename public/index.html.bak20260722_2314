          if (r.rol === 'cliente' && !r.id && _sesNativa.usuario_id) r.id = _sesNativa.usuario_id;
          return r;
        });
        localStorage.setItem('dt_sesion', JSON.stringify(Object.assign({}, _sesNativa, {roles: d.roles})));
