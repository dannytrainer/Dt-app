<script>
function renderDiaPlan(semana, diaIdx) {
  window._diaActual = diaIdx;
  if(!semana || !semana[diaIdx]) return;
  var dia = semana[diaIdx];
  var t = dia.totales;
  var letrasPlanes = ['A','B','C','D','E','F','G'];
  var tabs = '<div style="display:flex;gap:4px;overflow-x:auto;padding-bottom:8px;margin-bottom:12px;scrollbar-width:none">';
  semana.forEach(function(d,i) {
    var activo = i===diaIdx;
      var activo = i===diaIdx;
      tabs += '<button onclick="renderDiaPlan(window._planSemana,'+i+')" style="min-width:48px;padding:6px 8px;border-radius:8px;border:none;background:'+(activo?'#e31e24':'var(--gris)')+';color:'+(activo?'#fff':'var(--texto-secundario)')+';font-size:11px;font-weight:700;cursor:pointer;flex-shrink:0">Plan '+letrasPlanes[i]+'</button>';
  });
  tabs += '</div>';
  var totales = '<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:12px">';
  totales += '<div style="background:var(--gris);border-radius:8px;padding:8px;text-align:center"><div style="font-size:15px;font-weight:800;color:#e31e24">'+t.proteina+'g</div><div style="font-size:9px;color:var(--texto-secundario)">Proteína</div></div>';
  totales += '<div style="background:var(--gris);border-radius:8px;padding:8px;text-align:center"><div style="font-size:15px;font-weight:800;color:#f0a500">'+t.carbohidratos+'g</div><div style="font-size:9px;color:var(--texto-secundario)">Carbos</div></div>';
  totales += '<div style="background:var(--gris);border-radius:8px;padding:8px;text-align:center"><div style="font-size:15px;font-weight:800;color:#4caf50">'+t.grasas+'g</div><div style="font-size:9px;color:var(--texto-secundario)">Grasas</div></div>';
  totales += '<div style="background:var(--gris);border-radius:8px;padding:8px;text-align:center"><div style="font-size:15px;font-weight:800;color:var(--texto)">'+t.calorias+'</div><div style="font-size:9px;color:var(--texto-secundario)">kcal</div></div>';
  totales += '</div>';
  var letEl = document.getElementById('ali-plan-letra');
  if(letEl) letEl.textContent = 'Plan '+(letrasPlanes[diaIdx]||diaIdx+1);
  var comidas = '';
  dia.comidas.forEach(function(comida) {
    var mr = comida.macros_reales;
    var ico = comida.nombre.indexOf('Desayuno')>=0?'🌅':comida.nombre.indexOf('Snack')>=0?'🍎':comida.nombre.indexOf('Almuerzo')>=0?'🍱':comida.nombre.indexOf('Cena')>=0?'🌙':comida.nombre.indexOf('Pre')>=0?'⚡':'🍽️';
    var h = '<div style="background:var(--card);border:1px solid var(--borde);border-radius:12px;padding:12px;margin-bottom:10px">';
    h += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px"><div style="font-size:14px;font-weight:800;color:var(--texto)">'+ico+' '+comida.nombre+'</div><div style="font-size:12px;color:var(--texto-medio);font-weight:600">'+mr.kcal+' kcal</div></div>';
    var p1=Math.round(mr.proteina*10)/10, c1=Math.round(mr.carbos*10)/10, g1=Math.round(mr.grasas*10)/10;
    h += '<div style="display:flex;gap:6px;margin-bottom:10px"><span style="font-size:10px;background:#1a0a0a;color:#e31e24;border-radius:6px;padding:3px 8px">P: '+p1+'g</span><span style="font-size:10px;background:#1a120a;color:#f0a500;border-radius:6px;padding:3px 8px">C: '+c1+'g</span><span style="font-size:10px;background:#0a1a0a;color:#4caf50;border-radius:6px;padding:3px 8px">G: '+g1+'g</span></div>';
    comida.alimentos.forEach(function(al) {
      h += '<div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-top:1px solid var(--borde)">';
      h += '<div style="flex:1"><div style="font-size:13px;color:var(--texto);font-weight:600">'+al.nombre+(al.detalle?' <span style="color:var(--texto-medio);font-size:10px">('+al.detalle+')</span>':'')+'</div>';
      h += '<div style="font-size:10px;color:var(--texto-tenue);margin-top:2px">'+al.macros.proteina+'g P · '+al.macros.carbohidratos+'g C · '+al.macros.grasas+'g G</div></div>';
      h += '<div style="text-align:right;margin-left:8px"><div style="font-size:15px;font-weight:800;color:var(--texto)">'+(al.unidad?al.unidad.texto:al.porcion_g+'g')+'</div>';
      h += '<div style="font-size:10px;color:var(--texto-secundario)">'+al.macros.calorias+' kcal</div></div></div>';
    });
    h += '</div>';
    comidas += h;
  });
  document.getElementById('ali-plan-totales').innerHTML = totales;
  document.getElementById('ali-plan-comidas').innerHTML = tabs + comidas;
  // Blur para planes premium
  var contenedor = document.getElementById('ali-plan-comidas');
  var bloqueado = diaIdx >= 2 && !entEsPremium();
  var blurExist = document.getElementById('ali-blur-premium');
  if (blurExist) blurExist.remove();
  if (bloqueado) {
    contenedor.style.filter = 'blur(4px)';
    contenedor.style.pointerEvents = 'none';
    var overlay = document.createElement('div');
    overlay.id = 'ali-blur-premium';
    overlay.style.cssText = 'position:absolute;top:0;left:0;right:0;bottom:0;display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:10;padding:20px;text-align:center';
    overlay.innerHTML = '<div style="background:#111;border:2px solid #e31e24;border-radius:16px;padding:20px;max-width:280px"><div style="font-size:32px;margin-bottom:8px">🔒</div><div style="font-size:15px;font-weight:900;color:#fff;margin-bottom:8px">Plan Premium</div><div style="font-size:12px;color:#888;margin-bottom:16px">Los planes C-G requieren Plan Premium</div><button onclick="mostrarCandadoPremium(\'Los planes C-G requieren Plan Premium.\')" style="background:#e31e24;border:none;border-radius:10px;color:#fff;font-size:13px;font-weight:700;padding:10px 20px;cursor:pointer;width:100%;margin-bottom:10px">💳 Activar Premium</button><button onclick="document.getElementById(\'ali-blur-premium\').remove();document.getElementById(\'ali-plan-comidas\').style.filter=\'\';document.getElementById(\'ali-plan-comidas\').style.pointerEvents=\'\';renderDiaPlan(window._planSemana,0);" style="background:transparent;border:1px solid #333;border-radius:10px;color:#888;font-size:13px;padding:10px 20px;cursor:pointer;width:100%">← Volver al Plan A</button></div>';
    contenedor.parentNode.style.position = 'relative';
    contenedor.parentNode.appendChild(overlay);
  } else {
    contenedor.style.filter = '';
    contenedor.style.pointerEvents = '';
  }
}

function generarPlanAlimentario() {
  var id = window.clienteMedidasId || document.getElementById('rutina-cliente-id').value;
  if (!id) { toast('⚠️ Abre un cliente primero',false); return; }
  var btn = document.querySelector('[onclick="generarPlanAlimentario()"]');
  if (btn) btn.textContent = '⏳ Generando...';
  window._diaActual = 0;
  Promise.all([
    fetch('/api/alimentacion/'+id+'/plan',{method:'POST'}).then(function(r){return r.json();}),
    fetch('/api/alimentacion/'+id+'/semana').then(function(r){return r.json();})
  ]).then(function(results) {
    window._planActual = results[0];
    window._planSemana = results[1];
    var fecha = new Date(results[0].generado);
    document.getElementById('ali-plan-fecha').textContent = fecha.toLocaleDateString('es-CO',{day:'2-digit',month:'short',year:'numeric'});
    renderDiaPlan(results[1], 0);
    document.getElementById('modal-plan-ali').style.display = 'block';
    if (btn) btn.textContent = '⚡ Generar plan automático';
  }).catch(function(e) {
    alert('Error: '+e.message);
    if (btn) btn.textContent = '⚡ Generar plan automático';
  });
}

function generarTextoPlanAlimentario() {
  var diaIdx = window._diaActual || 0;
  var plan = (window._planSemana && window._planSemana[diaIdx]) ? window._planSemana[diaIdx] : window._planActual;
  if (!plan) return null;
  var txt = '🍽️ *Plan alimentario — '+plan.nombre+'*\n';
  txt += '📅 '+new Date(plan.generado).toLocaleDateString('es-CO')+'\n';
  txt += '⚖️ Peso objetivo: '+plan.peso_objetivo+'kg\n\n';
  txt += '📊 *Totales del día:*\n';
  txt += '• Proteína: '+plan.totales.proteina+'g\n';
  txt += '• Carbos: '+plan.totales.carbohidratos+'g\n';
  txt += '• Grasas: '+plan.totales.grasas+'g\n';
  txt += '• Calorías: '+plan.totales.calorias+' kcal\n\n';
  plan.comidas.forEach(function(c) {
    var ico = c.nombre.indexOf('Desayuno')>=0?'🌅':c.nombre.indexOf('Snack')>=0?'🍎':c.nombre.indexOf('Almuerzo')>=0?'🍱':c.nombre.indexOf('Cena')>=0?'🌙':'⚡';
    txt += ico+' *'+c.nombre+'* ('+c.macros_reales.kcal+' kcal)\n';
    c.alimentos.forEach(function(al) { txt += '  • '+al.nombre+' ('+al.preparacion+'): *'+(al.unidad ? al.unidad.texto : al.porcion_g+'g')+'*\n'; });
    txt += '\n';
  });
  txt += '💪 _' + (JSON.parse(localStorage.getItem('dt_sesion')||'{}').nombre||'Entrenador') + ' — DT App_';
  return txt;
}

function compartirPlanWA() {
  var txt = generarTextoPlanAlimentario();
  if (!txt) { toast('⚠️ Genera el plan primero',false); return; }
  var id = window.clienteMedidasId;
  fetch('/api/usuarios/' + id)
    .then(function(r) { return r.json(); })
    .then(function(u) {
      var tel = (u.telefono || '').replace(/[^0-9]/g, '');
      var url = tel ? 'https://wa.me/'+tel+'?text='+encodeURIComponent(txt)
                    : 'https://wa.me/?text='+encodeURIComponent(txt);
      window.open(url, '_blank');
    })
    .catch(function() {
      toast('❌ No se pudo obtener el teléfono del cliente',false);
    });
}

async function copiarPlanAlimentario() {
  var txt = generarTextoPlanAlimentario();
  if (!txt) { toast('⚠️ Genera el plan primero',false); return; }
  try {
    await navigator.clipboard.writeText(txt);
    toast('📋 Plan copiado al portapapeles');
  } catch(e) {
    toast('Error al copiar', false);
  }
}

async function compartirPlanNativo() {
  var txt = generarTextoPlanAlimentario();
  if (!txt) { toast('⚠️ Genera el plan primero',false); return; }
  if (typeof compartirTextoNativo === 'function') {
    await compartirTextoNativo(txt, 'Plan alimentario');
  }
}
</script>

