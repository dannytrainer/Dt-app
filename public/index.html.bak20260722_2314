<script>
// ── NAV BOTTOM ──────────────────────────────────────────
function toggleNavMenu(menu) {
  const funciones = document.getElementById('nav-menu-funciones');
  const herramientas = document.getElementById('nav-menu-herramientas');
  if (menu === 'funciones') {
    const visible = funciones.style.display !== 'none';
