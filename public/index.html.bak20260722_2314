    if (d.ok) {
      st.style.color='#4caf50';
      st.textContent='✓ Vinculado con ' + d.entrenador_nombre;
      codigo.value = '';
      setTimeout(() => {
        var panel = document.getElementById('tc-config-panel');
        if (panel) panel.remove();
      }, 1500);
